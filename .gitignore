# tooling
node_modules/
.venv/
__pycache__/
*.pyc

# build output
dist/

# user documents written by the dev / preview save server (one directory per project)
userdata/

# generated reports (tests, previews, audits)
reports/
projects/*/preview/

# locally downloaded tools (adb for phone install)
.tools/

# editors, OS
.vscode/
.idea/
.DS_Store
*.log
*.tsbuildinfo

# development notes kept locally, not published: architecture decisions and developer guides
docs/adr/
docs/ARCHITECTURE.md
docs/DEVELOPER_GUIDE.md
docs/PERFORMANCE_BUDGETS.md
docs/MOBILE_UX.md

# core package declaration output (tsc -b)
packages/*/build/
