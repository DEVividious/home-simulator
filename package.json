{
  "name": "home-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "displayName": "Home Simulator",
  "description": "Generic 3D home and apartment configurator engine. A building is a data package (projects/<id>/project.json) that AI-agent skills can author from CAD files or 2D floor plans. Runs in the browser and as an offline PWA on Android.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b packages/core && tsc -p packages/house-forge && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/verify/run_suite.mjs",
    "audit:genericity": "node scripts/audit/no-house-refs.mjs",
    "project:build": "vite-node scripts/project/build.ts --",
    "project:validate": "vite-node scripts/project/validate.ts --",
    "schema:generate": "vite-node scripts/schema/generate.ts",
    "i18n:gen": "node scripts/i18n/gen.mjs",
    "project:preview": "node scripts/project/preview.mjs",
    "project:print": "node scripts/project/print.mjs",
    "skills:catalog": "node scripts/skills/catalog-table.mjs",
    "phone": "node scripts/phone/phone.mjs",
    "audit:i18n": "node scripts/audit/i18n-check.mjs",
    "audit:core": "node scripts/audit/core-boundary.mjs",
    "plugin:build": "node scripts/plugin/build.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "jspdf": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.181.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.181.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "puppeteer-core": "25.16.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "5.3.0",
    "vitest": "4.1.12"
  }
}
