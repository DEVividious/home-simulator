{
 "title": "Home Simulator authoring plan (projects/<id>/source/plan.json)",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "properties": {
  "$schema": {
   "type": "string"
  },
  "schema": {
   "type": "string",
   "const": "home-simulator/plan"
  },
  "version": {
   "type": "number",
   "const": 1
  },
  "project": {
   "type": "object",
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
     "type": "string",
     "minLength": 1
    },
    "names": {
     "type": "object",
     "propertyNames": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
     },
     "additionalProperties": {
      "type": "string",
      "minLength": 1
     },
     "description": "the text in other languages: language code → text (the main field is in the package's language)"
    },
    "description": {
     "type": "string"
    },
    "documentTitle": {
     "type": "string"
    },
    "language": {
     "description": "the language the names are written in (en, pl); `names` add the other languages",
     "type": "string"
    },
    "buildingType": {
     "type": "string",
     "enum": [
      "house",
      "apartment"
     ]
    },
    "origin": {
     "description": "where the project origin is and how the axes run (human-readable)",
     "type": "string"
    },
    "metadata": {
     "type": "object",
     "propertyNames": {
      "type": "string"
     },
     "additionalProperties": {
      "type": [
       "string",
       "number",
       "boolean",
       "null"
      ]
     }
    }
   },
   "required": [
    "id",
    "name",
    "buildingType"
   ],
   "additionalProperties": false
  },
  "units": {
   "default": "m",
   "type": "string",
   "enum": [
    "m",
    "px"
   ]
  },
  "calibration": {
   "type": "object",
   "properties": {
    "pxPerM": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "pixels per metre of the source image"
    },
    "originPx": {
     "type": "array",
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "items": false,
     "minItems": 2,
     "maxItems": 2,
     "description": "pixel that becomes the project origin (x = 0, y = 0)"
    },
    "methods": {
     "description": "independent scale estimates (scale bar, printed area, door width…) — the build reports their agreement",
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "method": {
        "type": "string"
       },
       "pxPerM": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "note": {
        "type": "string"
       }
      },
      "required": [
       "method",
       "pxPerM"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "pxPerM",
    "originPx"
   ],
   "additionalProperties": false
  },
  "regularize": {
   "type": "boolean"
  },
  "source": {
   "type": "string",
   "description": "default provenance of every fact (e.g. \"floor plan image plan.png, calibrated from printed areas\")"
  },
  "defaults": {
   "default": {},
   "type": "object",
   "properties": {
    "exteriorWall": {
     "default": 0.3,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "interiorWall": {
     "default": 0.12,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "slab": {
     "default": 0.25,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "doorHeight": {
     "default": 2.05,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "leafHeight": {
     "default": 2,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "sill": {
     "default": 0.85,
     "type": "number",
     "minimum": 0
    },
    "head": {
     "default": 2.35,
     "type": "number",
     "exclusiveMinimum": 0
    },
    "confidence": {
     "default": "probable",
     "type": "string",
     "enum": [
      "confirmed",
      "probable",
      "unknown"
     ]
    },
    "basis": {
     "default": "approximate",
     "type": "string",
     "enum": [
      "dimensioned",
      "drawn",
      "approximate"
     ]
    }
   },
   "additionalProperties": false
  },
  "levels": {
   "minItems": 1,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "name": {
      "type": "string"
     },
     "names": {
      "type": "object",
      "propertyNames": {
       "type": "string",
       "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
       "type": "string",
       "minLength": 1
      },
      "description": "the text in other languages: language code → text (the main field is in the package's language)"
     },
     "floorZ": {
      "type": "number"
     },
     "ceiling": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "ceiling height above the floor [m]"
     },
     "cutHeight": {
      "description": "section height above the floor [m]; default: 10 cm above the highest window head, at least 2.30, below the ceiling",
      "type": "number",
      "exclusiveMinimum": 0
     },
     "slope": {
      "description": "sloped ceilings of every room on this level (attic): without a roof block it becomes a gable roof part over the level; with one, a cross-check. A room's own `ceiling` is its flat top",
      "type": "object",
      "properties": {
       "ridge": {
        "type": "string",
        "enum": [
         "X",
         "Y"
        ],
        "description": "the ridge line runs along this plan axis (X: left–right on the plan, Y: up–down)"
       },
       "ridgeAt": {
        "description": "coordinate of the ridge line on the other axis (a point coordinate: px in a px plan); default: middle of the level",
        "type": "number"
       },
       "lines": {
        "minItems": 1,
        "maxItems": 2,
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "at": {
           "type": "number",
           "description": "coordinate across the ridge (point units)"
          },
          "height": {
           "type": "number",
           "exclusiveMinimum": 0,
           "description": "ceiling height on this line [m]"
          }
         },
         "required": [
          "at",
          "height"
         ],
         "additionalProperties": false
        },
        "description": "height lines drawn on the plan (e.g. knee wall 1.40 and 2.20); two lines on one side of the ridge give the slope"
       },
       "pitch": {
        "description": "roof pitch [°] — needed when only one line is given",
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 80
       },
       "flat": {
        "description": "height of the flat ceiling top (collar beams) [m]; default: the level ceiling",
        "type": "number",
        "exclusiveMinimum": 0
       }
      },
      "required": [
       "ridge",
       "lines"
      ],
      "additionalProperties": false
     },
     "calibration": {
      "description": "px plans drawn as one image per level: the scale and origin of THIS level's image (the origin pixel = the same building corner on every image); default: the plan calibration",
      "type": "object",
      "properties": {
       "pxPerM": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "pixels per metre of the source image"
       },
       "originPx": {
        "type": "array",
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2,
        "description": "pixel that becomes the project origin (x = 0, y = 0)"
       },
       "methods": {
        "description": "independent scale estimates (scale bar, printed area, door width…) — the build reports their agreement",
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "method": {
           "type": "string"
          },
          "pxPerM": {
           "type": "number",
           "exclusiveMinimum": 0
          },
          "note": {
           "type": "string"
          }
         },
         "required": [
          "method",
          "pxPerM"
         ],
         "additionalProperties": false
        }
       }
      },
      "required": [
       "pxPerM",
       "originPx"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "id",
     "name",
     "floorZ",
     "ceiling"
    ],
    "additionalProperties": false
   }
  },
  "rooms": {
   "minItems": 1,
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "name": {
      "type": "string",
      "minLength": 1
     },
     "names": {
      "description": "the name in other languages (language code → name), e.g. {\"en\": \"Kitchen\"} next to a Polish name",
      "type": "object",
      "propertyNames": {
       "type": "string",
       "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
       "type": "string",
       "minLength": 1
      }
     },
     "level": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "kind": {
      "type": "string",
      "enum": [
       "bath",
       "kitchen",
       "garage",
       "tech",
       "hall",
       "bed",
       "living",
       "office",
       "storage",
       "room"
      ]
     },
     "tags": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "label": {
      "type": "string"
     },
     "rect": {
      "description": "[x0, y0, x1, y1] of the inner wall faces",
      "type": "array",
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
     },
     "polygon": {
      "description": "inner wall faces, edges along the plan axes or at 45° to them, corners in order along the outline",
      "minItems": 3,
      "type": "array",
      "items": {
       "type": "array",
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "items": false,
       "minItems": 2,
       "maxItems": 2
      }
     },
     "ceiling": {
      "description": "ceiling height above this room floor [m]; default: level ceiling",
      "type": "number",
      "exclusiveMinimum": 0
     },
     "areaPrinted": {
      "description": "area printed on the plan [m²] (checked against the computed area)",
      "type": "number",
      "exclusiveMinimum": 0
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "level",
     "kind"
    ],
    "additionalProperties": false
   }
  },
  "doors": {
   "default": [],
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "between": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
       },
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "the two rooms on either side; use \"exterior\" for an outside door"
     },
     "at": {
      "type": "array",
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "any point in the middle of the door opening (on or inside the wall between the rooms)"
     },
     "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "clear opening in the masonry [m]"
     },
     "type": {
      "default": "hinged-single",
      "description": "hinged-double: two leaves hinged at both jambs; folding: a bifold — two panels folding to the hinge side",
      "type": "string",
      "enum": [
       "hinged-single",
       "hinged-double",
       "folding",
       "sliding",
       "pocket"
      ]
     },
     "swingInto": {
      "description": "hinged, double, folding: the room the leaves open into, or \"exterior\" for an outward-opening outside door (default: the second room, or the room for an exterior door)",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "hinge": {
      "description": "hinged: hinge side as seen from the room the door opens into, looking at the wall; folding: the side the panels fold to",
      "type": "string",
      "enum": [
       "left",
       "right"
      ]
     },
     "slideTo": {
      "description": "sliding / pocket: the leaf moves towards the start (smaller coordinate) or end of the opening",
      "type": "string",
      "enum": [
       "start",
       "end"
      ]
     },
     "height": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "leafHeight": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "confidence": {
      "type": "string",
      "enum": [
       "confirmed",
       "probable",
       "unknown"
      ]
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "between",
     "at",
     "width"
    ],
    "additionalProperties": false
   }
  },
  "passages": {
   "default": [],
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "between": {
      "type": "array",
      "prefixItems": [
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
       },
       {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
     },
     "at": {
      "type": "array",
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
     },
     "width": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "height": {
      "type": "number",
      "exclusiveMinimum": 0
     }
    },
    "required": [
     "between",
     "at",
     "width"
    ],
    "additionalProperties": false
   }
  },
  "windows": {
   "default": [],
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "room": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "at": {
      "type": "array",
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "a point on the window wall, in the middle of the window"
     },
     "width": {
      "description": "width along the wall [m] (not with outline)",
      "type": "number",
      "exclusiveMinimum": 0
     },
     "sill": {
      "type": "number",
      "minimum": 0
     },
     "head": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "outline": {
      "description": "a glazing that is not a rectangle (a gable window under the roof): its corners as [coordinate along the wall (a point coordinate: x for a wall along X, y along Y; px in a px plan), height above the room floor (m)] — instead of width / sill / head; walls along the plan axes only",
      "minItems": 3,
      "type": "array",
      "items": {
       "type": "array",
       "prefixItems": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "items": false,
       "minItems": 2,
       "maxItems": 2
      }
     },
     "passable": {
      "description": "floor-level glazed door one can walk through onto the terrain",
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "room",
     "at"
    ],
    "additionalProperties": false
   }
  },
  "roofWindows": {
   "default": [],
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "room": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
     },
     "rect": {
      "type": "array",
      "prefixItems": [
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       },
       {
        "type": "number"
       }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4,
      "description": "[x0, y0, x1, y1] of the window in the sloped ceiling, seen from above"
     }
    },
    "required": [
     "id",
     "room",
     "rect"
    ],
    "additionalProperties": false
   }
  },
  "roof": {
   "description": "the roof: parts over the levels (gable, hip, shed, flat), dormers, chimneys; without it a level slope builds a gable part",
   "type": "object",
   "properties": {
    "covering": {
     "default": 0.05,
     "description": "covering thickness (tiles, sheet) across the planes [m]",
     "type": "number",
     "minimum": 0
    },
    "buildup": {
     "default": 0.25,
     "description": "thickness of the structure under it (rafters, insulation, lining) [m]",
     "type": "number",
     "exclusiveMinimum": 0
    },
    "eaves": {
     "default": 0.5,
     "description": "default overhang at the eaves [m]",
     "type": "number",
     "minimum": 0
    },
    "verge": {
     "default": 0.3,
     "description": "default overhang at a gable end [m]",
     "type": "number",
     "minimum": 0
    },
    "ridgeHeight": {
     "description": "height of the highest ridge (top of the covering) above z = 0 from the drawings [m] — checked (±10 cm)",
     "type": "number",
     "exclusiveMinimum": 0
    },
    "parts": {
     "minItems": 1,
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
       },
       "level": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "description": "the level the part covers: its rooms get their ceilings from it"
       },
       "type": {
        "type": "string",
        "enum": [
         "gable",
         "hip",
         "shed",
         "flat"
        ]
       },
       "rect": {
        "description": "[x0, y0, x1, y1] — OUTER faces of the walls under the part (points); or \"rooms\"; default: the level outline (it must be a rectangle unless flat)",
        "type": "array",
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         },
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "items": false,
        "minItems": 4,
        "maxItems": 4
       },
       "rooms": {
        "description": "the part covers these rooms (their outline grown by the exterior wall)",
        "minItems": 1,
        "type": "array",
        "items": {
         "type": "string",
         "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        }
       },
       "polygon": {
        "description": "flat part only: outer faces of the walls under it, axis-aligned edges",
        "minItems": 4,
        "type": "array",
        "items": {
         "type": "array",
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "items": false,
         "minItems": 2,
         "maxItems": 2
        }
       },
       "ridge": {
        "description": "gable / hip: the ridge runs along this plan axis (default: along the longer side)",
        "type": "string",
        "enum": [
         "X",
         "Y"
        ]
       },
       "ridgeAt": {
        "description": "coordinate of the ridge line on the other axis (a point coordinate); default: the middle",
        "type": "number"
       },
       "down": {
        "description": "shed (and a flat roof with a pitch): the side the roof falls towards",
        "type": "string",
        "enum": [
         "N",
         "S",
         "E",
         "W"
        ]
       },
       "pitch": {
        "description": "roof pitch [°] (gable / hip / shed: 5–75; flat: 0–5)",
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 80
       },
       "pitchEnds": {
        "description": "hip: pitch of the two end planes [°] (default: pitch)",
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 80
       },
       "knee": {
        "description": "height above the level floor where the underside of the roof structure meets the OUTER face of the eaves walls [m] (knee wall); default: the level ceiling + slab (a roof on top of the ceiling), for flat: the level ceiling",
        "type": "number"
       },
       "lines": {
        "description": "instead of knee: ceiling height lines from the plan (1.40 / 2.20); two lines on one side of the ridge give the pitch",
        "minItems": 1,
        "maxItems": 2,
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "at": {
           "type": "number",
           "description": "coordinate across the ridge (point units)"
          },
          "height": {
           "type": "number",
           "exclusiveMinimum": 0,
           "description": "ceiling height on this line [m]"
          }
         },
         "required": [
          "at",
          "height"
         ],
         "additionalProperties": false
        }
       },
       "eaves": {
        "description": "overhang at the eaves [m] (default: roof.eaves; flat: 0)",
        "type": "number",
        "minimum": 0
       },
       "verge": {
